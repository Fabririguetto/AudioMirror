<Window x:Class="AudioMirror.Core.OsdNotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AudioMirror OSD"
        Width="440" Height="100"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        Focusable="False"
        ShowActivated="False"
        FontFamily="Segoe UI"
        ResizeMode="NoResize">

    <Border Background="#1C1E24" CornerRadius="10" 
            BorderBrush="#007ACC" BorderThickness="1.5"
            Padding="14,10" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="2" Direction="270" Color="#000000" Opacity="0.75" />
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="46" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Icon Column -->
            <Border Grid.Column="0" Width="38" Height="38" Background="#262A36" CornerRadius="8"
                    BorderBrush="#2E323D" BorderThickness="1" HorizontalAlignment="Left" VerticalAlignment="Center">
                <TextBlock Text="🔊" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <!-- Details Column -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0,0,0">
                <!-- Tag & Volume Header -->
                <Grid Margin="0,0,0,3">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="7" Height="7" Fill="#00E676" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="DISPOSITIVO DE AUDIO ACTIVO" FontSize="10" FontWeight="Bold" 
                                   Foreground="#0098FF" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtVolume" Text="Vol: 100%" FontSize="11" FontWeight="SemiBold" 
                                   Foreground="#F0F2F5" />
                    </StackPanel>
                </Grid>

                <!-- Device Friendly Name -->
                <TextBlock x:Name="TxtDeviceName" Text="Altavoces Realtek High Definition Audio" 
                           FontSize="14" FontWeight="Bold" Foreground="#FFFFFF"
                           TextTrimming="CharacterEllipsis" Margin="0,0,0,3" />

                <!-- Status / Mirroring info -->
                <Grid>
                    <TextBlock x:Name="TxtStatus" Text="AudioMirror • Salida Principal" 
                               FontSize="10" Foreground="#8E95A5" TextTrimming="CharacterEllipsis" />
                    <ProgressBar x:Name="PbVolume" Height="3" Minimum="0" Maximum="100" Value="100" 
                                 Background="#252830" Foreground="#00E676" BorderThickness="0"
                                 HorizontalAlignment="Right" Width="80" VerticalAlignment="Center" />
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</Window>