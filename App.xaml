<Application x:Class="AudioMirror.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <!-- Tema oscuro y estilos modernos -->
        <SolidColorBrush x:Key="BgBrush" Color="#121316" />
        <SolidColorBrush x:Key="CardBrush" Color="#1C1E24" />
        <SolidColorBrush x:Key="BorderBrush" Color="#2E323D" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F0F2F5" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#8E95A5" />
        <SolidColorBrush x:Key="AccentBrush" Color="#007ACC" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#0098FF" />
        <SolidColorBrush x:Key="StopBrush" Color="#E53935" />
        <SolidColorBrush x:Key="StopHoverBrush" Color="#FF5252" />
        <SolidColorBrush x:Key="MeterBgBrush" Color="#252830" />
    </Application.Resources>
</Application>
